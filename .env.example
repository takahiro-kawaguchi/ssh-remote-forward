# --- 踏み台設定 ---
JUMP_USER=my-jump-user

# --- リモートサーバー設定 ---
SSH_USER=your_remote_user
SSH_HOST=remote-server.example.com
SSH_PORT=22

# --- 鍵ファイル設定 (NEW) ---
# ssh_keyフォルダの中にあるファイル名を指定してください
# 例: id_rsa, id_ed25519 など
IDENTITY_FILE=id_ed25519

# --- トンネル設定 ---
# カンマ区切りで複数指定可能: リモートポート:転送先ホスト:転送先ポート
TUNNELS=22000:localhost:22,19000:localhost:8050